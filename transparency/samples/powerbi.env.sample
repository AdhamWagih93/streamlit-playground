# ---------------------------------------------------------------------------
# Connection settings for the Transparency Dashboard.
#
#   cp samples/powerbi.env.sample samples/powerbi.env   and fill in the blanks.
#
# samples/powerbi.env is git-ignored — it holds a real password, so keep it out
# of the repository and off shared drives. In production these values come from
# the platform's secret store, not from a file.
# ---------------------------------------------------------------------------

# --- The report server -----------------------------------------------------

# Scheme + host + port only. No path, no trailing slash.
POWERBI_BASE_URL=https://reports.internal.example.com

# The one host this proxy may open a socket to. Must match the host in
# POWERBI_BASE_URL exactly; anything else is refused before the request leaves.
POWERBI_ALLOWED_HOST=reports.internal.example.com

# Path of the transparency report on the report server.
# Find it by opening the report in the portal and copying the path after the host.
POWERBI_REPORT_PATH=/Reports/powerbi/Transparency

# Optional: a full URL instead, when the report needs query parameters
# (rs:Embed=true hides the report server's own chrome inside the frame).
# Set this OR POWERBI_REPORT_PATH — this one wins if both are present.
#POWERBI_REPORT_URL=https://reports.internal.example.com/Reports/powerbi/Transparency?rs:Embed=true

# --- Upstream credentials --------------------------------------------------
# BASIC | NTLM | NONE
#
#   BASIC  a plain service account, or a domain account the server accepts over Basic
#   NTLM   a Windows domain account — the usual case for an on-prem Report Server
#   NONE   no upstream auth. Local testing only.
POWERBI_AUTH_TYPE=NTLM

# For NTLM either write the account as DOMAIN\user and leave POWERBI_DOMAIN empty,
# or write the bare username and set POWERBI_DOMAIN. Both forms work.
POWERBI_USERNAME=EXAMPLE\svc_transparency
POWERBI_PASSWORD=

# Only if you did not put the domain in the username above.
#POWERBI_DOMAIN=EXAMPLE

# Rarely needed. Some hardened NTLM configurations require it.
#POWERBI_WORKSTATION=

# --- This application ------------------------------------------------------

# Who may open the dashboard. Leave true anywhere real.
APP_SECURITY_ENABLED=true

# A stop-gap account so you can sign in before an identity provider is wired up.
# Replace with LDAP/OIDC before this reaches users — see REVAMP.md.
SPRING_SECURITY_USER_NAME=transparency
SPRING_SECURITY_USER_PASSWORD=

# Copy shown in the viewer chrome.
APP_UI_BRAND=Transparency
APP_UI_TITLE=Transparency Dashboard
APP_UI_REPORTNAME=Public Payments — Quarterly Transparency Report
APP_UI_SUPPORTCONTACT=data-office@example.com

SERVER_PORT=8080
