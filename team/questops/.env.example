# Copy to .env next to docker-compose.yml. Everything has a demo-safe default.
# Keys are QO_-prefixed on the host side: compose maps QO_JIRA_USER -> JIRA_USER
# inside the container. (Same-named vars trigger a self-reference bug in
# podman-compose's ${VAR:-default} substitution.)

# demo mode = seeded users/board/jobs, no external calls except Ollama
QO_DEMO_MODE=true
QO_SECRET_KEY=change-me

# --- Host name resolution (so internal hostnames resolve in the container) ---
# The container has its own network namespace and does NOT inherit the host's
# /etc/hosts or DNS, which is why you may be forced to use IPs. By default the
# compose file bind-mounts the host's /etc/hosts read-only, so hostnames the
# host resolves via /etc/hosts work inside the container with no IPs.
#   - Override the hosts file path if yours is elsewhere:
QO_HOSTS_FILE=/etc/hosts
#   - If your endpoints come from CORPORATE DNS (or the host uses a
#     systemd-resolved stub at 127.0.0.53 the container can't reach), set the
#     real resolver(s)/search domain(s) and uncomment the dns:/dns_search:
#     lines in docker-compose.yml:
QO_DNS=
QO_DNS_SEARCH=

# --- AI (local Ollama) ---
# podman: host.containers.internal · docker: host.docker.internal
QO_OLLAMA_URL=http://host.containers.internal:11434
QO_OLLAMA_MODEL=llama3.1

# --- Jira Data Center (one project) ---
QO_JIRA_BASE_URL=https://jira.mycorp.local
QO_JIRA_USER=
QO_JIRA_PASSWORD=
QO_JIRA_PROJECT_KEY=DEVOPS
# board columns in flow order; Reopened issues appear in the first column
QO_JIRA_BOARD_STATUSES=Open,In Progress,Resolved,Closed
QO_JIRA_DONE_STATUSES=Closed
QO_JIRA_REVIEW_STATUSES=Resolved
QO_JIRA_REOPENED_STATUSES=Reopened
# Closed column shows only tickets closed within this many days
QO_JIRA_CLOSED_WINDOW_DAYS=30

# --- Jenkins ---
QO_JENKINS_URL=https://jenkins.mycorp.local
QO_JENKINS_USER=
QO_JENKINS_TOKEN=
# long-running = elapsed > job's avg runtime * factor (minutes = fallback when no history)
QO_JENKINS_LONG_RUNNING_FACTOR=1.5
QO_JENKINS_LONG_RUNNING_MINUTES=45
# only failures from the last N days; comma-separated path tokens to skip
QO_JENKINS_FAILURE_WINDOW_DAYS=14
QO_JENKINS_IGNORE=DevOps_Test

# --- Elasticsearch (Jenkins KPI + error analysis) ---
QO_ES_URL=https://es.mycorp.local:9200
QO_ES_API_KEY=
QO_ES_VERIFY_SSL=true
# may be a single index, a wildcard pattern, or a comma list — use a pattern
# when builds roll over into dated indices, e.g. ef-devops-jenkins-builds*
QO_JENKINS_KPI_INDEX=jenkins-kpi
QO_ERROR_ANALYSIS_INDEX=jenkins-error-analysis
# minute marks when the KPI loader runs (:05/:35) — countdown uses container TZ
QO_KPI_SYNC_MINUTES=5,35
# KPI panel reads the WHOLE time window (default: past week); per-request cap
QO_KPI_MAX_DOCS=10000
# which doc field(s) hold the build time (most-authoritative first) — the KPI
# window is applied on these. Change it if your index names the build timestamp
# differently; the panel's "why 0 builds?" diagnostics list the fields it found.
QO_KPI_DATE_FIELDS=builddate,@timestamp
# exclude KPI docs whose job path contains one of these tokens (the KPI
# sibling of QO_JENKINS_IGNORE — its own list on purpose)
QO_KPI_IGNORE=

# --- Logging Health monitor (ELK) ---
# The Logging Health tab loops the inventory projects/apps and reports each
# app's log-index estate. Log indices follow the naming pattern:
#   ${index_prefix}-${project}-${env}-${app}-${logtype}-yyyy.ww
# The ${index_prefix} is resolved PER APP from its inventory deploy_platform —
# the app's group_vars/<app>/*.yml (e.g. cicd.yml), else the project-wide
# group_vars/all. Built-in map (always applies): OCP→oc, LinuxVM→vmlin,
# WindowsVM→vmwin, K8s→k8s. Only set this to ADD or override extra platforms:
QO_LOG_PLATFORM_PREFIXES=
# fallback ${index_prefix} for apps/projects with no deploy_platform at all
# (blank = those are flagged "no deploy_platform" and skipped)
QO_LOG_INDEX_PREFIX=
# env token(s) served by the PRIMARY ES (QO_ES_URL above) — usually just prd
QO_LOG_PRD_ENVS=prd
# an app whose newest log is older than this (hours) is flagged "stale"
QO_LOG_STALE_HOURS=48
# CI/CD deployments index on the PRD ES — last-deploy date + never-deployed
# detection (never-deployed app/envs are expected to have no logs)
QO_LOG_DEPLOY_INDEX=ef-cicd-deployments
# only count deployments whose testflag = this as the last deployment (blank = all)
QO_LOG_DEPLOY_TESTFLAG=Normal
# an env counts as DEPLOYED only when the deployment's status = this (blank = all)
QO_LOG_DEPLOY_STATUS=SUCCESS
# log retention policy (days): logs kept OLDER than this are flagged
# "over-retained" (minor). prd = 6 months, non-prd = 3 weeks.
QO_LOG_RETENTION_PRD_DAYS=183
QO_LOG_RETENTION_NONPRD_DAYS=21
# an app/project storing >= this multiple of the fleet-average app/project log
# size is flagged "over-sized" (minor issue, -10 score)
QO_LOG_OVERSIZE_FACTOR=2.0
# environment display order inside each project (side-by-side columns);
# EXTRA_ENVS are shown separately (e.g. dr)
QO_LOG_MAIN_ENVS=dev,qc,uat,prd
QO_LOG_EXTRA_ENVS=
# The PRIMARY ES (QO_ES_URL / QO_ES_API_KEY above) serves the PRD-env log
# indices. This SEPARATE connection holds every OTHER environment's indices
# (dev / qc / uat / …). Leave QO_ES_NONPRD_URL blank if you only monitor prd.
QO_ES_NONPRD_URL=https://es-nonprd.mycorp.local:9200
QO_ES_NONPRD_API_KEY=
QO_ES_NONPRD_VERIFY_SSL=true

# --- Upgrade checker: the ONLY outbound-internet calls QuestOps makes ---
# Latest versions come from Docker Hub, GitHub and Artifact Hub (NOT
# endoflife.date). Hosts behind a corporate proxy: set QO_UPGRADES_PROXY —
# internal Jira/Jenkins/ES/LDAP traffic never uses it. Point any *_API_BASE at
# an internal mirror if the public host is blocked in your region.
QO_UPGRADES_PROXY=
QO_UPGRADES_VERIFY_SSL=true
QO_DOCKERHUB_API_BASE=https://hub.docker.com/v2
QO_GITHUB_API_BASE=https://api.github.com
QO_ARTIFACTHUB_API_BASE=https://artifacthub.io/api/v1
QO_ERROR_ANALYSIS_DAYS=14
QO_TZ=UTC

# --- Mail (Logging Health email reports) ---
# The Logging page can email a per-project HTML report. Leave QO_SMTP_HOST
# blank to disable sending (the in-app preview always works; demo mode
# simulates the send).
# QO_MAIL_TRANSPORT=ews  → Exchange Web Services via exchangelib (like
#   send_mail.py: Credentials + Configuration(server=HOST) + Account(FROM,
#   autodiscover=False) + Message(HTMLBody).send()). Use this when the mail
#   server rejects SMTP AUTH ("No suitable authentication method found").
#   QO_SMTP_HOST is then the EWS server, QO_SMTP_USER/PASSWORD the account
#   credentials, QO_SMTP_FROM the primary SMTP address.
# QO_MAIL_TRANSPORT=smtp → classic smtplib (PORT/STARTTLS/SSL apply).
QO_MAIL_TRANSPORT=ews
# bare recipient names get this appended (e.g. "a.meshhal" → a.meshhal@mycorp.local)
QO_MAIL_DEFAULT_DOMAIN=mycorp.local
# send attempts before giving up + wait between attempts (seconds)
QO_MAIL_RETRIES=3
QO_MAIL_RETRY_WAIT=3.0
# always looped into every logging report email (blank = disabled)
QO_ADMIN_EMAIL=devops-admin@mycorp.local
QO_SMTP_HOST=smtp.mycorp.local
QO_SMTP_PORT=587
QO_SMTP_USER=
QO_SMTP_PASSWORD=
QO_SMTP_STARTTLS=true
QO_SMTP_SSL=false
QO_SMTP_FROM=questops@mycorp.local

# --- Platform Postgres (extra platform tables) ---
# A SEPARATE database from QuestOps' own DB. The Access page cross-checks its
# devops_projects table (project, company, dev_team, qc_team, ops_team)
# against the cloned inventory: missing projects on either side, duplicated
# rows, wrong team/company assignments. Blank = panel shows "not configured".
QO_PLATFORM_DATABASE_URL=postgresql+psycopg2://reader:secret@platform-db.mycorp.local:5432/platform
QO_PLATFORM_PROJECTS_TABLE=devops_projects
# feature flag: expose WRITE actions on the table in the Access page (quick
# fixes, row editor, delete/dedupe). false = read-only cross-check — the
# endpoints are disabled server-side as well, not merely hidden
QO_PLATFORM_DB_ACTIONS=true

# --- LDAP (login gated on group membership) ---
QO_LDAP_URL=ldaps://ldap.mycorp.local:636
QO_LDAP_BIND_DN=CN=svc-questops,OU=Service Accounts,DC=mycorp,DC=local
QO_LDAP_BIND_PASSWORD=
QO_LDAP_BASE_DN=OU=Users,DC=mycorp,DC=local
QO_LDAP_USER_ATTR=sAMAccountName
QO_LDAP_REQUIRED_GROUP=CN=devops-team,OU=Groups,DC=mycorp,DC=local
# everyone in the group is an approver EXCEPT these usernames (plain members)
QO_MEMBER_USERNAMES=
# individual users allowed into QuestOps WITHOUT the team LDAP group — they see
# ONLY the pages below, and those pages are hidden from everyone else
# (page keys: overview,projects,focus,board,ci,repos,logging,access,migration,upgrades,team,me,activity)
QO_RESTRICTED_USERS=
QO_RESTRICTED_PAGES=
# users who can view ALL pages — restricted ones included (wins over the list above)
QO_FULL_ACCESS_USERS=
# DANGEROUS — username-only login (password ignored; LDAP group gates still apply)
QO_LOGIN_WITHOUT_PASSWORD=false
# branding — company name + logo (sidebar, login card, printed report)
# EASIEST: copy your logo to ./branding/logo.png — it is mounted and found automatically.
# QO_COMPANY_LOGO is only for a logo elsewhere: a path INSIDE the container (or relative
# to the questops folder). /api/branding shows which paths were checked.
QO_COMPANY_NAME=
QO_COMPANY_LOGO=
# NOTE: the above LDAP settings gate LOGIN only. Access Management resolves each
# project's [TEAM] group members by running an asset from your cloned Engine
# repository — scripts/Tools/LDAP/getTeamMembersCN.sh <team> — which sources a .prd
# profile via `. $HOME/.prd`. QuestOps runs it with HOME set to the Engine repo
# root, so .prd (committed at the repo root) is sourceable as $HOME/.prd inside
# the container. Just add the Engine repo on the Repositories page and clone it;
# no extra LDAP directories to configure.

# --- Repositories page ---
# repos are ADDED FROM THE UI; config only carries the ADO instance creds.
# git clone/pull uses USER + PASSWORD; the REST browse uses USER + PAT.
# Leave one empty and the other is used for both.
# ADO_URL is the INSTANCE root (NOT a collection) — collections are
# enumerated so the whole instance is browsed / access-audited.
QO_ADO_URL=https://ado.mycorp.local
QO_ADO_USER=svc-questops
QO_ADO_PASSWORD=
QO_ADO_PAT=
# usernames excluded from repo-specific-access analysis (repo creators/admins
# expected to hold access on every repo — like the service account)
QO_ADO_ACCESS_EXCLUDE=

# --- ADO -> Gitea migration (Access page) ---
# Gitea targets are configured FROM THE UI (one instance per ADO collection);
# only the TLS-verify knob lives here (false for self-signed Gitea certs).
QO_GITEA_VERIFY_SSL=true

# --- Git push for approved repo actions ---
QO_GIT_TOKEN=
QO_GIT_USER_NAME=questops-bot
QO_GIT_USER_EMAIL=questops-bot@mycorp.local
